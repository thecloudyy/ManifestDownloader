<ui:FluentWindow
    x:Class="ManifestDownloader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Steam Manifest Downloader"
    Width="1180"
    Height="780"
    MinWidth="980"
    MinHeight="640"
    ExtendsContentIntoTitleBar="True"
    WindowBackdropType="Mica"
    WindowCornerPreference="Round"
    WindowStartupLocation="CenterScreen"
    PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- Card surface used by every panel -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Selection colors are fixed, theme-independent values: WPF-UI re-derives
             its AccentFill* brushes from the OS accent at runtime, which turns a
             selected row into a pale sky-blue slab on light-blue Windows accents. -->
        <SolidColorBrush x:Key="RowSelectedBg" Color="#263B52" />
        <SolidColorBrush x:Key="RowSelectedBorder" Color="#3B5C82" />

        <Style x:Key="SmallBtn" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Dark, borderless column headers with our own template: the default
             template paints an inner border light blue on hover, which property
             setters cannot reach. Style triggers drive Background/Foreground here. -->
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DividerStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="8,7,8,7" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillColorTertiaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Quiet splitter: invisible until hovered -->
        <Style TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Slim chip-style buttons for compact header actions -->
        <Style x:Key="ChipBtn" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,1" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <!-- Square icon-only variant (no visible label) -->
        <Style x:Key="IconBtn" TargetType="ui:Button" BasedOn="{StaticResource ChipBtn}">
            <Setter Property="Padding" Value="4,1" />
            <Setter Property="Width" Value="24" />
        </Style>

        <!-- Rounded, hover/selection-aware library row -->
        <Style x:Key="LibItem" TargetType="ListBoxItem">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <!-- Right margin reserves a gutter for the ListBox's overlay
                             scrollbar: without it the thumb/track paint across the
                             row's right edge (measured: thumb at viewport-11..-5). -->
                        <Border x:Name="Bd"
                                CornerRadius="6"
                                Padding="6,5"
                                Margin="0,1,18,1"
                                Background="Transparent"
                                BorderThickness="1"
                                BorderBrush="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{StaticResource RowSelectedBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush"
                                        Value="{StaticResource RowSelectedBorder}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <ui:TitleBar Grid.Row="0" Title="Steam Manifest Downloader" />

        <Grid Grid.Row="1" Margin="16,8,16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ══ Library ══ -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12,12,12,10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Library" Style="{StaticResource SectionTitle}" />
                        <ui:Button Grid.Column="1" Style="{StaticResource ChipBtn}" Content="All"
                                   ToolTip="Select every game" Margin="0,0,4,0" Click="BtnSelectAll_Click" />
                        <ui:Button Grid.Column="2" Style="{StaticResource ChipBtn}" Content="None"
                                   ToolTip="Clear selection" Margin="0,0,4,0" Click="BtnSelectNone_Click" />
                        <ui:Button Grid.Column="3" x:Name="BtnRefreshLib" Style="{StaticResource IconBtn}"
                                   Icon="{ui:SymbolIcon ArrowSync24}" ToolTip="Rescan the library (F5)"
                                   Click="BtnRefreshLib_Click" />
                    </Grid>

                    <ui:TextBox Grid.Row="1"
                                x:Name="TxtLibSearch"
                                PlaceholderText="Search by name or AppID"
                                Icon="{ui:SymbolIcon Search24}"
                                IconPlacement="Left"
                                Margin="0,0,0,6"
                                TextChanged="TxtLibSearch_TextChanged" />

                    <Grid Grid.Row="2">
                        <ListBox x:Name="LibraryBox"
                                 SelectionMode="Multiple"
                                 ItemContainerStyle="{StaticResource LibItem}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 VirtualizingPanel.IsVirtualizing="True"
                                 SelectionChanged="LibraryBox_SelectionChanged"
                                 MouseDoubleClick="LibraryBox_DoubleClick"
                                 PreviewKeyDown="LibraryBox_PreviewKeyDown">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="96" Height="45"
                                                CornerRadius="4"
                                                ClipToBounds="True"
                                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                                            <Grid>
                                                <Image Source="{Binding Cover}"
                                                       Stretch="{Binding ThumbStretch}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                                <Border Width="19" Height="19"
                                                        CornerRadius="10"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,-2,-2,-2"
                                                        Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        Visibility="{Binding IsSelected,
                                                            RelativeSource={RelativeSource AncestorType=ListBoxItem},
                                                            Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="&#x2713;"
                                                               FontWeight="Bold"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <TextBlock Text="{Binding Depots, StringFormat='{}{0} depots'}"
                                                           Style="{StaticResource Muted}" />
                                                <TextBlock Text="&#x00B7;" Style="{StaticResource Muted}" Margin="5,0" />
                                                <TextBlock Text="{Binding AppId}" Style="{StaticResource Muted}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock x:Name="LblLibEmpty"
                                   Text="No games match."
                                   Style="{StaticResource Muted}"
                                   FontSize="12"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Visibility="Collapsed" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblLibStatus" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Style="{StaticResource Muted}" Margin="8,0,0,0"
                                   Text="double-click downloads" />
                    </Grid>
                </Grid>
            </Border>

            <!-- ══ Downloader ══ -->
            <Grid Grid.Column="1" Margin="14,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="120" />
                </Grid.RowDefinitions>

                <!-- Source -->
                <Border Grid.Row="0" Style="{StaticResource Card}">
                    <StackPanel>
                        <WrapPanel Orientation="Horizontal">
                            <CheckBox x:Name="TglGithub" Content="GitHub mirror" IsChecked="True"
                                      VerticalAlignment="Center" Margin="0,0,20,0"
                                      Checked="Source_Changed" Unchecked="Source_Changed" />
                            <CheckBox x:Name="TglDeX" Content="ManifestDeX (keyless)" IsChecked="True"
                                      VerticalAlignment="Center" Margin="0,0,20,0"
                                      Checked="Source_Changed" Unchecked="Source_Changed" />
                            <TextBlock Text="Fallback API:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <RadioButton x:Name="RbApiNone" Content="None" IsChecked="True"
                                         VerticalAlignment="Center" Margin="0,0,12,0" Checked="Mode_Checked" />
                            <RadioButton x:Name="RbMorrenus" Content="Morrenus"
                                         VerticalAlignment="Center" Margin="0,0,12,0" Checked="Mode_Checked" />
                            <RadioButton x:Name="RbManifestHub" Content="ManifestHub"
                                         VerticalAlignment="Center" Checked="Mode_Checked" />
                        </WrapPanel>

                        <TextBlock x:Name="LblModeHint" Style="{StaticResource Muted}" Margin="0,6,0,0"
                                   Text="Public mirror, no key required." />

                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="API key" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <ui:PasswordBox x:Name="TxtKeyPass" Grid.Column="1"
                                            IsEnabled="False"
                                            RevealButtonEnabled="True"
                                            PlaceholderText="Required for Morrenus / ManifestHub" />
                            <ui:Button Grid.Column="2" x:Name="BtnGetKey" Style="{StaticResource SmallBtn}"
                                       Icon="{ui:SymbolIcon Key24}" Content="Get key"
                                       IsEnabled="False" Margin="8,0,0,0"
                                       ToolTip="Open the key page in your browser"
                                       Click="BtnGetKey_Click" />
                        </Grid>

                        <CheckBox x:Name="ChkRememberKey" Content="Remember key on this PC (DPAPI-encrypted)"
                                  IsChecked="True" Margin="0,8,0,0"
                                  Checked="RememberKey_Changed" Unchecked="RememberKey_Changed" />
                    </StackPanel>
                </Border>

                <!-- Actions (WrapPanel: at MinWidth the old row overflowed and clipped
                     the last button - with a wrap, Reinstall drops to a second line
                     instead of running off the window edge) -->
                <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Text="AppID" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ui:TextBox x:Name="TxtAppId" Width="150" PlaceholderText="e.g. 1361510"
                                KeyDown="TxtAppId_KeyDown" />
                    <ui:Button x:Name="BtnDownload" Appearance="Primary" CornerRadius="6"
                               Content="Download" Icon="{ui:SymbolIcon ArrowDownload24}"
                               Margin="10,0,8,0" Click="BtnDownload_Click" />
                    <ui:Button x:Name="BtnCancel" CornerRadius="6" Content="Cancel"
                               Icon="{ui:SymbolIcon DismissCircle24}" IsEnabled="False"
                               Margin="0,0,8,0" Click="BtnCancel_Click" />
                    <ui:Button x:Name="BtnOpenFolder" CornerRadius="6" Content="Depot folder"
                               Icon="{ui:SymbolIcon FolderOpen24}"
                               Click="BtnOpenFolder_Click" />
                    <ui:Button x:Name="BtnReinstall" CornerRadius="6" Content="Reinstall"
                               Icon="{ui:SymbolIcon ArrowSync24}" Margin="8,0,0,0"
                               ToolTip="Download the latest release from GitHub and replace this copy (the app restarts)"
                               Click="BtnReinstall_Click" />
                </WrapPanel>

                <!-- Progress -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="14,10">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="ProgOverall" Height="8" Minimum="0" Maximum="100" Value="0"
                                         VerticalAlignment="Center" />
                            <TextBlock x:Name="LblPercent" Grid.Column="1" Width="44" Margin="10,0,0,0"
                                       HorizontalAlignment="Right" FontWeight="SemiBold" Text="0%" />
                        </Grid>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LblStatus" Style="{StaticResource Muted}" FontSize="12"
                                       Text="Idle." TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="LblElapsed" Grid.Column="1" Style="{StaticResource Muted}"
                                       Margin="12,0,0,0" Text="" />
                        </Grid>
                        <Grid Margin="0,4,0,0">
                            <TextBlock x:Name="LblSummary" HorizontalAlignment="Right"
                                       FontWeight="SemiBold" FontSize="12" Text="" />
                        </Grid>
                    </StackPanel>
                </Border>

                <ui:InfoBar Grid.Row="3" x:Name="ResultBar" IsOpen="False" IsClosable="True" Margin="0,10,0,0" />

                <!-- Queue -->
                <Grid Grid.Row="4" Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Queue" Style="{StaticResource SectionTitle}" />
                    <TextBlock Grid.Column="1" x:Name="LblQueueCount" Style="{StaticResource Muted}" Margin="10,0,0,0" />
                </Grid>

                <ui:ListView Grid.Row="5" x:Name="QueueView"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             VirtualizingPanel.IsVirtualizing="True">
                    <ListView.ItemContainerStyle>
                        <!-- Our own row template: the default theme template paints
                             selection/hover itself (light band), which setters cannot
                             reach. Background here is fully template-driven. -->
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="6,3" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border x:Name="Bd"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="5"
                                                Padding="{TemplateBinding Padding}"
                                                Margin="{TemplateBinding Margin}">
                                            <GridViewRowPresenter Content="{TemplateBinding Content}"
                                                                  Columns="{TemplateBinding GridView.ColumnCollection}"
                                                                  VerticalAlignment="Center" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background"
                                                        Value="{StaticResource RowSelectedBg}" />
                                                <Setter TargetName="Bd" Property="BorderBrush"
                                                        Value="{StaticResource RowSelectedBorder}" />
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Opacity" Value="0.5" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Game" Width="196">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Game}" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding App}" Style="{StaticResource Muted}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Depot" Width="84" DisplayMemberBinding="{Binding Depot}" />
                            <GridViewColumn Header="Manifest" Width="168" DisplayMemberBinding="{Binding Manifest}" />
                            <GridViewColumn Header="Progress" Width="104">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <ProgressBar Height="6" Minimum="0" Maximum="100"
                                                     VerticalAlignment="Center" Width="96"
                                                     Value="{Binding RowProgress, Mode=OneWay}" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Status" Width="210">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}"
                                                   Foreground="{Binding StatusBrush}"
                                                   TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ui:ListView>

                <GridSplitter Grid.Row="6" Height="6" Margin="0,3"
                              ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"
                              HorizontalAlignment="Stretch" />

                <!-- Log -->
                <Grid Grid.Row="7" Margin="0,2,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Log" Style="{StaticResource SectionTitle}" />
                    <ui:Button Grid.Column="2" Style="{StaticResource SmallBtn}" Content="Copy"
                               Icon="{ui:SymbolIcon Clipboard24}" ToolTip="Copy the whole log to the clipboard"
                               Margin="0,0,6,0" Click="BtnCopyLog_Click" />
                    <ui:Button Grid.Column="3" Style="{StaticResource SmallBtn}" Content="Clear"
                               Icon="{ui:SymbolIcon Broom24}" ToolTip="Clear the log"
                               Click="BtnClearLog_Click" />
                </Grid>

                <ui:RichTextBox Grid.Row="8" x:Name="LogBox"
                                IsReadOnly="True"
                                IsDocumentEnabled="True"
                                FontSize="12"
                                FontFamily="Cascadia Mono, Consolas"
                                Background="Transparent"
                                BorderThickness="0"
                                Padding="4,2"
                                VerticalScrollBarVisibility="Auto" />
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="16,5"
                Background="{DynamicResource ApplicationBackgroundBrush}"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="LblSteamPath" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" x:Name="LblMode" Style="{StaticResource Muted}" Margin="14,0" />
                <TextBlock Grid.Column="3" Style="{StaticResource Muted}"
                           Text="F5 rescan · Ctrl+F search · Enter download · Esc cancel" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
