{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ManifestDownloader",
  "version": "1.0.0",
  "identifier": "com.thecloudyy.manifestdownloader",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Steam Manifest Downloader",
        "width": 1180,
        "height": 780,
        "minWidth": 980,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
